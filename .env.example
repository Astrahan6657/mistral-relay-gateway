# Listener
HOST=127.0.0.1
PORT=8790

# Optional path to persisted hot-reloadable JSON config
CONFIG_PATH=./config.json

# Mode: "direct_mistral" (https://api.mistral.ai) or "new_api" (sidecar in front of New API / One API)
UPSTREAM_MODE=direct_mistral
UPSTREAM_BASE=https://api.mistral.ai

# When PASSTHROUGH_AUTH=false, gateway injects UPSTREAM_API_KEY automatically (great for local desktop use)
PASSTHROUGH_AUTH=true
UPSTREAM_API_KEY=

# Optional local client auth key (used when PASSTHROUGH_AUTH=false) and Admin Web UI token (required if bound non-locally)
GATEWAY_KEY=
ADMIN_TOKEN=

# Mistral compatibility rules (aligned with Mistral OpenAPI 3.1.0)
# MISTRAL_CHAT_ENDPOINT: "native" (/v1/chat/completions) or "openai_compat" (/openai/v1/chat/completions)
MISTRAL_CHAT_ENDPOINT=native
STRICT_MISTRAL_WHITELIST=true
RESPONSES_MODE=auto
NORMALIZE_CONTENT_ARRAYS=true

# Image compaction limits
KEEP_IMAGES=4
MAX_BODY_BYTES=3145728
KEEP_IMAGES_OTHER=8
MAX_BODY_BYTES_OTHER=10485760

# Upstream timeout & concurrency
UPSTREAM_TIMEOUT=300
CONCURRENCY_WAIT_SECONDS=120
MODEL_CONCURRENCY_LIMITS=

# Optional extra Mistral model names / prefixes (comma-separated)
MISTRAL_MODELS=
MISTRAL_PREFIXES=mistral-,codestral-,devstral-,pixtral-,ministral-,magistral-,deepseek-v4,zai-glm-,glm-5
