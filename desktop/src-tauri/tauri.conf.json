{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mistral Relay Gateway",
  "version": "0.1.0",
  "identifier": "dev.mistralrelay.gateway",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Mistral Relay Gateway",
        "width": 1220,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/mistral-relay-gateway"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
